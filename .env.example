# ==============================================================================
# Agentic RAG Legal QA Hanoi - Cấu hình Môi trường Mẫu (100% Free Providers)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Ứng dụng & Máy chủ FastAPI
# ------------------------------------------------------------------------------
APP_NAME="Agentic RAG Legal QA Hanoi"
DEBUG=true
API_V1_STR="/api/v1"
HOST="0.0.0.0"
PORT=8000
LOG_LEVEL="INFO"
API_KEY=""
ALLOWED_ORIGINS="http://localhost:3000"
RATE_LIMIT_PER_MINUTE=30

# ------------------------------------------------------------------------------
# 2. Cấu hình LLM & Embeddings (Các nhà cung cấp MIỄN PHÍ - Free Tier)
# ------------------------------------------------------------------------------

# --- [MẶC ĐỊNH] GROQ API (OpenAI-compatible) ---
# Set OPENAI_API_KEY only through a local secret manager or the Render dashboard.
# Never commit a real key to this file or to source control.
LLM_PROVIDER="groq"
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.groq.com/openai/v1"
MODEL_NAME="openai/gpt-oss-20b"
EMBEDDING_MODEL="BAAI/bge-m3"

# --- [HUGGING FACE] Inference API for Embeddings (GPU-accelerated, Free Tier) ---
# Get your token at: https://huggingface.co/settings/tokens (Read access)
# Add to .env: HUGGINGFACE_API_KEY=hf_your_token_here
HUGGINGFACE_API_KEY=""
USE_HF_EMBEDDING_API=true
HF_EMBEDDING_MODEL="BAAI/bge-m3"
HF_EMBEDDING_URL="https://api-inference.huggingface.co/models/BAAI/bge-m3"
HF_EMBEDDING_BATCH_SIZE=32
HF_EMBEDDING_TIMEOUT=30.0

# --- [GPT-OSS SPECIFIC SETTINGS] ---
# GPT-OSS specific generation settings
GPT_OSS_TEMPERATURE=0.1
GPT_OSS_MAX_TOKENS=4096
GPT_OSS_TOP_P=0.9

# --- [REDIS] Cache for Embeddings ---
