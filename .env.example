# ==============================================================================
# Agentic RAG Legal QA Hanoi - Cấu hình Môi trường Mẫu (100% Free Providers)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Ứng dụng & Máy chủ FastAPI
# ------------------------------------------------------------------------------
APP_NAME="Agentic RAG Legal QA Hanoi"
DEBUG=true
API_V1_STR="/api/v1"
HOST="0.0.0.0"
PORT=8000
LOG_LEVEL="INFO"
API_KEY=""
ALLOWED_ORIGINS="http://localhost:3000"
RATE_LIMIT_PER_MINUTE=30

# ------------------------------------------------------------------------------
# 2. Cấu hình LLM & Embeddings (Các nhà cung cấp MIỄN PHÍ - Free Tier)
# ------------------------------------------------------------------------------

# --- [LỰA CHỌN 1: KHUYẾN NGHỊ] GOOGLE GEMINI API (Hoàn toàn Miễn phí) ---
# Đăng ký lấy API Key miễn phí tại: https://aistudio.google.com/app/apikey
# Google AI Studio hỗ trợ giao thức tương thích OpenAI, không cần thẻ tín dụng.
OPENAI_API_KEY="your-gemini-api-key-here"
OPENAI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/"
MODEL_NAME="gemini-3.8-flash"
EMBEDDING_MODEL="text-embedding-004"

# --- [LỰA CHỌN 2] GROQ API (Tốc độ siêu nhanh, Miễn phí 100%) ---
# Đăng ký lấy API Key miễn phí tại: https://console.groq.com/keys
# Bỏ comment 4 dòng dưới nếu bạn muốn dùng Groq làm LLM:
# OPENAI_API_KEY="gsk_your-groq-api-key-here"
# OPENAI_BASE_URL="https://api.groq.com/openai/v1"
# MODEL_NAME="llama-3.3-70b-versatile"
# EMBEDDING_MODEL="text-embedding-004"

# --- [LỰA CHỌN 3] OPENROUTER (Free Models) ---
# Đăng ký tại: https://openrouter.ai/keys
# Bỏ comment các dòng dưới nếu muốn dùng các model :free trên OpenRouter:
# OPENAI_API_KEY="sk-or-v1-your-openrouter-key"
# OPENAI_BASE_URL="https://openrouter.ai/api/v1"
# MODEL_NAME="google/gemini-2.0-flash-exp:free"

# --- [LỰA CHỌN 4] OLLAMA (Chạy local 100% Offline Miễn phí) ---
# Cài đặt Ollama từ: https://ollama.com
# Bỏ comment các dòng dưới nếu bạn có Ollama chạy trên máy:
# OPENAI_API_KEY="ollama"
# OPENAI_BASE_URL="http://localhost:11434/v1"
# MODEL_NAME="llama3.1:8b"

# ------------------------------------------------------------------------------
# 3. Vector Database (Qdrant)
# ------------------------------------------------------------------------------
# Chạy Qdrant Cloud (nhập URL cluster và API key) hoặc chạy local qua Docker (make docker-up)
QDRANT_URL=""
QDRANT_HOST="localhost"
QDRANT_PORT=6333
QDRANT_COLLECTION="legal_chunks"
QDRANT_ACTIVE_ALIAS="legal_chunks"
QDRANT_API_KEY=""
CORPUS_VERSION="2026-10-09.1"
EMBEDDING_REVISION="bge-m3-1024-v1"

# ------------------------------------------------------------------------------
# 4. Giới hạn Tham số Agent (Tối ưu hóa Token Free Tier)
# ------------------------------------------------------------------------------
MAX_SUBQUERIES=3
MAX_RETRIEVAL_RESULTS=5
SIMILARITY_THRESHOLD=0.75
