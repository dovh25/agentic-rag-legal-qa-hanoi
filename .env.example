# ==============================================================================
# Agentic RAG Legal QA Hanoi - Environment Configuration Example
# ==============================================================================

# Application
APP_NAME="Agentic RAG Legal QA Hanoi"
DEBUG=true
API_V1_STR="/api/v1"
HOST="0.0.0.0"
PORT=8000
LOG_LEVEL="INFO"

# LLM & Embeddings (OpenAI / Compatible)
OPENAI_API_KEY="your-openai-api-key"
OPENAI_BASE_URL="https://api.openai.com/v1"
MODEL_NAME="gpt-4o-mini"
EMBEDDING_MODEL="text-embedding-3-small"

# Vector Database (Qdrant)
QDRANT_HOST="localhost"
QDRANT_PORT=6333
QDRANT_COLLECTION="hanoi_legal_corpus"
QDRANT_API_KEY=""

# Database / Storage (Optional)
DATABASE_URL="postgresql://user:password@localhost:5432/legal_qa"

# Agent Budgets & Constraints
MAX_SUBQUERIES=3
MAX_RETRIEVAL_RESULTS=5
SIMILARITY_THRESHOLD=0.75
